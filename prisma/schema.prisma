// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  DISABLED
}

enum Gender {
  MEN
  WOMEN
  UNISEX
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum InventoryTxType {
  RESTOCK
  SALE
  ADJUSTMENT
  RETURN
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELLED
}

enum CustomDesignStatus {
  SUBMITTED
  REVIEWED
  QUOTED
  REJECTED
}

enum PaymentChannel {
  CARD
  MOMO
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REFUNDED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

// ---------------------------------------------------------------------------
// Roles & Users
// ---------------------------------------------------------------------------

model Role {
  id          String   @id @default(uuid())
  name        String   @unique @db.VarChar(50)
  permissions Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")

  users User[]

  @@map("roles")
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique @db.VarChar(255)
  passwordHash String?    @map("password_hash") @db.VarChar(255)
  firstName    String?    @map("first_name") @db.VarChar(100)
  lastName     String?    @map("last_name") @db.VarChar(100)
  phone        String?    @db.VarChar(30)
  roleId       String?    @map("role_id")
  isStaff      Boolean    @default(false) @map("is_staff")
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at")

  role Role? @relation(fields: [roleId], references: [id])

  createdProducts       Product[]              @relation("ProductCreatedBy")
  inventoryTransactions InventoryTransaction[] @relation("InventoryTxCreatedBy")
  orders                Order[]
  customDesigns         CustomDesign[]
  auditLogs             AuditLog[]             @relation("AuditLogAdminUser")

  @@map("users")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Category {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(100)
  slug      String   @unique @db.VarChar(120)
  gender    Gender?
  parentId  String?  @map("parent_id")
  createdAt DateTime @default(now()) @map("created_at")

  parent   Category?  @relation("CategoryParent", fields: [parentId], references: [id])
  children Category[] @relation("CategoryParent")

  products Product[]

  @@map("categories")
}

model Product {
  id             String        @id @default(uuid())
  name           String        @db.VarChar(200)
  slug           String        @unique @db.VarChar(220)
  description    String?
  categoryId     String?       @map("category_id")
  basePrice      Decimal       @map("base_price") @db.Decimal(12, 2)
  currency       String        @default("RWF") @db.VarChar(10)
  isCustomizable Boolean       @default(false) @map("is_customizable")
  status         ProductStatus @default(DRAFT)
  createdBy      String?       @map("created_by")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at")

  category Category? @relation(fields: [categoryId], references: [id])
  creator  User?     @relation("ProductCreatedBy", fields: [createdBy], references: [id])

  variants      ProductVariant[]
  images        ProductImage[]
  customDesigns CustomDesign[]

  @@index([categoryId], map: "idx_products_category")
  @@map("products")
}

model ProductVariant {
  id            String   @id @default(uuid())
  productId     String   @map("product_id")
  sku           String   @unique @db.VarChar(60)
  size          String?  @db.VarChar(20)
  color         String?  @db.VarChar(40)
  priceOverride Decimal? @map("price_override") @db.Decimal(12, 2)
  createdAt     DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  images                ProductImage[]
  inventory             Inventory?
  inventoryTransactions InventoryTransaction[]
  orderItems            OrderItem[]

  @@index([productId], map: "idx_variants_product")
  @@map("product_variants")
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String  @map("product_id")
  variantId String? @map("variant_id")
  url       String
  position  Int     @default(0)
  altText   String? @map("alt_text") @db.VarChar(255)

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@map("product_images")
}

// ---------------------------------------------------------------------------
// Inventory
// ---------------------------------------------------------------------------

model Inventory {
  id                String   @id @default(uuid())
  variantId         String   @unique @map("variant_id")
  quantityOnHand    Int      @default(0) @map("quantity_on_hand")
  quantityReserved  Int      @default(0) @map("quantity_reserved")
  reorderThreshold  Int?     @default(5) @map("reorder_threshold")
  warehouseLocation String?  @map("warehouse_location") @db.VarChar(100)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId], map: "idx_inventory_variant")
  @@map("inventory")
}

model InventoryTransaction {
  id          String          @id @default(uuid())
  variantId   String?         @map("variant_id")
  changeQty   Int             @map("change_qty")
  type        InventoryTxType
  referenceId String?         @map("reference_id")
  reason      String?
  createdBy   String?         @map("created_by")
  createdAt   DateTime        @default(now()) @map("created_at")

  variant ProductVariant? @relation(fields: [variantId], references: [id])
  creator User?           @relation("InventoryTxCreatedBy", fields: [createdBy], references: [id])

  @@map("inventory_transactions")
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

model Order {
  id              String      @id @default(uuid())
  userId          String?     @map("user_id")
  status          OrderStatus @default(PENDING)
  totalAmount     Decimal     @map("total_amount") @db.Decimal(12, 2)
  currency        String      @default("RWF") @db.VarChar(10)
  shippingAddress Json?       @map("shipping_address")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @default(now()) @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id])

  items    OrderItem[]
  payments Payment[]

  @@index([userId], map: "idx_orders_user")
  @@map("orders")
}

model OrderItem {
  id            String  @id @default(uuid())
  orderId       String  @map("order_id")
  variantId     String? @map("variant_id")
  quantity      Int
  unitPrice     Decimal @map("unit_price") @db.Decimal(12, 2)
  customization Json?

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId], map: "idx_order_items_order")
  @@map("order_items")
}

model CustomDesign {
  id            String             @id @default(uuid())
  userId        String?            @map("user_id")
  baseProductId String?            @map("base_product_id")
  designData    Json               @map("design_data")
  status        CustomDesignStatus @default(SUBMITTED)
  createdAt     DateTime           @default(now()) @map("created_at")

  user        User?    @relation(fields: [userId], references: [id])
  baseProduct Product? @relation(fields: [baseProductId], references: [id])

  @@map("custom_designs")
}

// ---------------------------------------------------------------------------
// Payments
// ---------------------------------------------------------------------------

model Payment {
  id           String         @id @default(uuid())
  orderId      String         @map("order_id")
  provider     String         @default("flutterwave") @db.VarChar(20)
  channel      PaymentChannel
  txRef        String         @unique @map("tx_ref") @db.VarChar(100)
  providerTxId String?        @map("provider_tx_id") @db.VarChar(100)
  amount       Decimal        @db.Decimal(12, 2)
  currency     String         @default("RWF") @db.VarChar(10)
  status       PaymentStatus  @default(PENDING)
  payerPhone   String?        @map("payer_phone") @db.VarChar(30)
  rawPayload   Json?          @map("raw_payload")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @default(now()) @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId], map: "idx_payments_order")
  @@index([txRef], map: "idx_payments_tx_ref")
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

model AuditLog {
  id          String      @id @default(uuid())
  adminUserId String?     @map("admin_user_id")
  action      AuditAction
  entityType  String      @map("entity_type") @db.VarChar(50)
  entityId    String?     @map("entity_id")
  before      Json?
  after       Json?
  createdAt   DateTime    @default(now()) @map("created_at")

  adminUser User? @relation("AuditLogAdminUser", fields: [adminUserId], references: [id])

  @@map("audit_logs")
}
