# PostgreSQL connection string
DATABASE_URL=

# JWT access and refresh token signing
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Flutterwave v4 sandbox (OAuth client credentials and webhook secret hash)
FLW_CLIENT_ID_SANDBOX=
FLW_SECRET_KEY_SANDBOX=
FLW_WEBHOOK_SECRET_HASH=
FLW_API_BASE_URL=https://developersandbox-api.flutterwave.com
FLW_REDIRECT_URL=

# Supabase Storage signed uploads
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=
